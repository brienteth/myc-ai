{
  "manifest_version": 3,
  "name": "MYCA Sovereign Wallet",
  "version": "1.1.0",
  "description": "Zero-Gas Hardware PUF & Autonomous Agentic Payment Wallet for MYCA Network (Chain ID 108) with window.myc Provider",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "MYCA Sovereign Wallet"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:4040/*",
    "http://127.0.0.1:4040/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inpage.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
