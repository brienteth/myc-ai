# ==============================================================================
# ⚡ MYCA EXECUTION OS - ÜRETİM (PRODUCTION) ÇEVRE DEĞİŞKENLERİ (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 🤖 MODEL & INFERENCE MOTORU AYARLARI
# ------------------------------------------------------------------------------
# Çıkarsama motoru: auto | llama.cpp | ollama | mock
MYCA_BACKEND=auto

# Kullanılacak model veya 0G Compute Network model ismi (ör. gpt-5.6-luna, qwen3.6-plus, gpt-5.6-sol)
MYCA_MODEL=gpt-5.6-sol
MYCA_MODEL_PATH=sk-1aa505ff-0da9-470f-b63d-4713949622cb
ZG_COMPUTE_URL=https://router-api.0g.ai/v1

# Apple Silicon GPU (Metal) Hızlandırma (-1: Tüm katmanlar GPU'da, 0: Sadece CPU)
MYCA_GPU_LAYERS=-1
MYCA_CTX=4096
MYCA_VERBOSE=false

# Ollama Sunucusu (Ollama kullanıyorsanız)
OLLAMA_HOST=http://localhost:11434
MYCA_OLLAMA_MODEL=llama3.2:3b

# Spekülatif Çıkarım (Hızlı Taslak + Doğrulama Çift Modelleri)
MYCA_SPECULATIVE=false
MYCA_DRAFT_MODEL=phi3:mini
MYCA_VERIFY_MODEL=llama3.2:3b


# ------------------------------------------------------------------------------
# 2. 🌐 COLONY P2P MESH & OPACUS H3 GLOBAL DISCOVERY (Çoklu Cihaz Ağı)
# ------------------------------------------------------------------------------
# Opacus H3 Sinyalleşme ve Global Peer Discovery Sunucu URL'si:
# Yerel ağ (LAN) dışında İnternet üzerinden farklı cihazları (Mac, Windows, Cloud GPU)
# tek bir küme (cluster) olarak bağlamak ve WebRTC NAT geçişi sağlamak için gereklidir.
OPACUS_H3_URL=https://h3.myca.ai
OPACUS_API_KEY=opak_3e3a6cc1e20650bd2cb46f59864311c4d8e933a5


# ------------------------------------------------------------------------------
# 3. 🔐 LLM MODEL & APİ ANAHTARLARI (Bulut Model Desteği İçin)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=


# ------------------------------------------------------------------------------
# 4. 🛠️ İLETİŞİM & ENTEGRASYON SKİLL İZİNLERİ
# ------------------------------------------------------------------------------
# E-posta gönderme yetenekleri için (communication.send skill'i)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Telegram Bot entegrasyonu için
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack & Webhook entegrasyonları için
SLACK_WEBHOOK_URL=
